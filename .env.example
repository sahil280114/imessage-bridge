# Listen port for the bridge HTTP server.
BRIDGE_PORT=4720

# Random 32+ char shared secret. Used by both directions:
#   Amber backend → bridge:   Authorization: Bearer <BRIDGE_TOKEN>
#   bridge → Amber backend:   Authorization: Bearer <BRIDGE_TOKEN>
# Generate one with: openssl rand -hex 24
BRIDGE_TOKEN=replace-me-with-random-string

# Where the bridge POSTs inbound iMessage events.
# Production:  https://api.your-amber.com/imessage/webhook
# Local dev:   http://localhost:3000/imessage/webhook
AMBER_WEBHOOK_URL=https://api.your-amber.com/imessage/webhook

# Optional. Defaults to `imsg` resolved from PATH.
# IMSG_BIN=/opt/homebrew/bin/imsg

# Optional. Args passed to `imsg watch`. Default is --json.
# IMSG_WATCH_ARGS=--json

# Optional. The Apple ID iMessage handle this bridge sends from. Only used
# for /health output and logging — does not affect behavior.
# IMSG_FROM=amber@example.com
